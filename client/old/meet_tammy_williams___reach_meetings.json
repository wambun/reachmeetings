sh-id=\"Containerhqn49inlineContent-gridContainer\" data-testid=\"mesh-container-content\"><section id=\"comp-lhqkvr3d\" tabindex=\"-1\" class=\"Oqnisf comp-lhqkvr3d wixui-section\" data-block-level-container=\"ClassicSection\"><div id=\"bgLayers_comp-lhqkvr3d\" data-hook=\"bgLayers\" data-motion-part=\"BG_LAYER comp-lhqkvr3d\" class=\"MW5IWV\"><div data-testid=\"colorUnderlay\" class=\"LWbAav Kv1aVt\"></div><div id=\"bgMedia_comp-lhqkvr3d\" data-motion-part=\"BG_MEDIA comp-lhqkvr3d\" class=\"VgO9Yg\"></div></div><div data-mesh-id=\"comp-lhqkvr3dinlineContent\" data-testid=\"inline-content\" class=\"\"><div data-mesh-id=\"comp-lhqkvr3dinlineContent-gridContainer\" data-testid=\"mesh-container-content\"><div id=\"comp-ktd1fnut\" class=\"Z_l5lU ku3DBC zQ9jDz qvSjx3 Vq6kJx comp-ktd1fnut wixui-rich-text\" data-testid=\"richTextElement\"><h2 class=\"font_2 wixui-rich-text__text\" style=\"line-height:normal; font-size:25px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">Tammy Williams<br class=\"wixui-rich-text__text\">\nVice President of Strategic Accounts</span></h2></div><div id=\"comp-ktd1fnv4\" class=\"comp-ktd1fnv4 aVng1S wixui-horizontal-line\"></div><div id=\"comp-ktd1fnva\" class=\"MazNVa comp-ktd1fnva wixui-image\"><div data-testid=\"linkElement\" class=\"j7pOnl\"><img fetchpriority=\"high\" id=\"img_comp-ktd1fnva\" src=\"https://static.wixstatic.com/media/28cd78_e43a3acc9022444997774babb647bfab~mv2.png/v1/fill/w_220,h_321,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/tammy_heic.png\" alt=\"tammy.heic\" style=\"object-fit:cover\" class=\"BI8PVQ Tj01hh\" width=\"220\" height=\"321\"></div></div><div id=\"comp-ktd1fnvw1\" class=\"Z_l5lU ku3DBC zQ9jDz qvSjx3 Vq6kJx comp-ktd1fnvw1 wixui-rich-text\" data-testid=\"richTextElement\"><p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,futura-lt-w05-book,sans-serif;\" class=\"wixui-rich-text__text\">Tammy has worked in sales, marketing and customer service her entire career.&nbsp; She transitioned from the corporate sector to hospitality in 2005 where her skills were honed in group sales while fostering her passion for all things travel.&nbsp; </span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,futura-lt-w05-book,sans-serif;\" class=\"wixui-rich-text__text\">In 2016, Tammy began her work on the meeting and event planning side of the industry, specializing in medical meeting sales. Her approach has always been simple, to treat others the way she wishes to be treated.&nbsp; She is driven to help others and is always seeking opportunities to be a conduit in meeting needs and adding value to her clients and coworkers alike. &nbsp;</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,futura-lt-w05-book,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,futura-lt-w05-book,sans-serif;\" class=\"wixui-rich-text__text\">Tammy and her husband Rickey have three sons, two grandbabies and the meanest, most loved Shih Tzu in Texas named Coco. They spend their free time traveling, often RV'ing across the country, at the pickleball courts or just playing board games at home in north Texas. Their family motto is, \"Life is short. Fill it up,\" and they certainly do.</span></span></p></div><div id=\"comp-ktd1fnvo\" class=\"comp-ktd1fnvo wixui-image-button\" aria-describedby=\"03472540-4f6b-44e2-b721-cb2d00a26143\"><a data-testid=\"link\" href=\"mailto:Tammy@reachmeetings.com\" target=\"_self\" class=\"QP6ZLS z9LPSw\" aria-label=\"\" tabindex=\"0\"><div role=\"img\" class=\"nXJ9tS\" data-testid=\"linkImageContainer\"><div class=\"PRnra1\"><img id=\"img_comp-ktd1fnvo_0\" src=\"https://static.wixstatic.com/media/035244_6af9c4421a85482ca71b02dc782a276a~mv2.png/v1/fill/w_25,h_25,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/035244_6af9c4421a85482ca71b02dc782a276a~mv2.png\" alt=\"\" role=\"none\" style=\"object-fit:contain;object-position:unset\" class=\"FaQ3s0 Tj01hh\" width=\"29\" height=\"25\"></div><div class=\"PRnra1\"><img id=\"img_comp-ktd1fnvo_1\" src=\"https://static.wixstatic.com/media/035244_ad00e9a4df534dccbc20a627b0861168~mv2.png/v1/fill/w_25,h_25,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/035244_ad00e9a4df534dccbc20a627b0861168~mv2.png\" alt=\"\" role=\"none\" style=\"object-fit:contain;object-position:unset\" class=\"UPdSQG Tj01hh\" width=\"29\" height=\"25\"></div><div class=\"PRnra1\"><img id=\"img_comp-ktd1fnvo_2\" src=\"https://static.wixstatic.com/media/035244_6af9c4421a85482ca71b02dc782a276a~mv2.png/v1/fill/w_25,h_25,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/035244_6af9c4421a85482ca71b02dc782a276a~mv2.png\" alt=\"\" role=\"none\" style=\"object-fit:contain;object-position:unset\" class=\"m5L7Le Tj01hh\" width=\"29\" height=\"25\"></div></div></a></div></div></div></section></div></div></div></div></div></div></div></main><div id=\"soapAfterPagesContainer\" class=\"soapAfterPagesContainer page-without-sosp\"><div data-mesh-id=\"soapAfterPagesContainerinlineContent\" data-testid=\"inline-content\" class=\"\"><div data-mesh-id=\"soapAfterPagesContainerinlineContent-gridContainer\" data-testid=\"mesh-container-content\"><div id=\"comp-jpe