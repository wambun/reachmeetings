fications image.png\" style=\"object-fit:cover\" class=\"BI8PVQ Tj01hh\" width=\"70\" height=\"37\"></div></div><div id=\"comp-ko38rigq\" class=\"MazNVa comp-ko38rigq wixui-image\"><div data-testid=\"linkElement\" class=\"j7pOnl\"><img fetchpriority=\"high\" id=\"img_comp-ko38rigq\" src=\"https://static.wixstatic.com/media/28cd78_45007cfa1ab34957b6eea9596c8651ff~mv2.png/v1/fill/w_75,h_38,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/CVT-Certification-Event_Management-gdm_p.png\" alt=\"CVT-Certification-Event_Management-gdm.p\" style=\"object-fit:cover\" class=\"BI8PVQ Tj01hh\" width=\"75\" height=\"38\"></div></div><div id=\"comp-k69udymo\" class=\"comp-k69udymo wixui-image-button\" aria-describedby=\"cb0ce09c-420d-4f17-b529-290ba9fc70bc\"><a data-testid=\"link\" href=\"mailto:gretchen@reachmeetings.com\" target=\"_self\" class=\"QP6ZLS z9LPSw\" aria-label=\"\" tabindex=\"0\"><div role=\"img\" class=\"nXJ9tS\" data-testid=\"linkImageContainer\"><div class=\"PRnra1\"><img id=\"img_comp-k69udymo_0\" src=\"https://static.wixstatic.com/media/035244_6af9c4421a85482ca71b02dc782a276a~mv2.png/v1/fill/w_25,h_25,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/035244_6af9c4421a85482ca71b02dc782a276a~mv2.png\" alt=\"\" role=\"none\" style=\"object-fit:contain;object-position:unset\" class=\"FaQ3s0 Tj01hh\" width=\"29\" height=\"25\"></div><div class=\"PRnra1\"><img id=\"img_comp-k69udymo_1\" src=\"https://static.wixstatic.com/media/035244_ad00e9a4df534dccbc20a627b0861168~mv2.png/v1/fill/w_25,h_25,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/035244_ad00e9a4df534dccbc20a627b0861168~mv2.png\" alt=\"\" role=\"none\" style=\"object-fit:contain;object-position:unset\" class=\"UPdSQG Tj01hh\" width=\"29\" height=\"25\"></div><div class=\"PRnra1\"><img id=\"img_comp-k69udymo_2\" src=\"https://static.wixstatic.com/media/035244_6af9c4421a85482ca71b02dc782a276a~mv2.png/v1/fill/w_25,h_25,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/035244_6af9c4421a85482ca71b02dc782a276a~mv2.png\" alt=\"\" role=\"none\" style=\"object-fit:contain;object-position:unset\" class=\"m5L7Le Tj01hh\" width=\"29\" height=\"25\"></div></div></a></div><div id=\"comp-k60791f0\" class=\"MazNVa comp-k60791f0 wixui-image rYiAuL\"><a data-testid=\"linkElement\" href=\"http://www.linkedin.com/in/gretchenmitchell\" target=\"_blank\" class=\"j7pOnl\"><img fetchpriority=\"high\" id=\"img_comp-k60791f0\" src=\"https://static.wixstatic.com/media/28cd78_133422d23dfd4df8b0fb858dba06b21e~mv2.png/v1/fill/w_26,h_20,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/LI-In-Bug.png\" alt=\"LI-In-Bug.png\" style=\"object-fit:cover\" class=\"BI8PVQ Tj01hh\" width=\"26\" height=\"20\"></a></div><div id=\"comp-k5yaels7\" class=\"Z_l5lU ku3DBC zQ9jDz qvSjx3 Vq6kJx comp-k5yaels7 wixui-rich-text\" data-testid=\"richTextElement\"><p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,sans-serif;\" class=\"wixui-rich-text__text\">Hello and thank you for visiting our site.&nbsp; I would love the opportunity to tell you about myself in person but for now short a bio will have to do...</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,sans-serif;\" class=\"wixui-rich-text__text\">First you should know that I am fueled by new experiences.&nbsp; I have paid my dues as a road warrior having flown a million miles by the young age of 27 and it didn't stop there...&nbsp; Another thing you should know is that I am passionate about bringing people together to solve problems, learn, and spread joy.&nbsp; We founded REACH Meetings &amp; Events because we know there is a need for our unique consultative, collaborative, and creative approach. &nbsp;</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,sans-serif;\" class=\"wixui-rich-text__text\">Technically, I specialize in bringing strategic thinking and analytical skills to large scale program management.&nbsp; I am a passionate leader. </span><span style=\"font-family:futura-lt-w01-book,sans-serif;\" class=\"wixui-rich-text__text\">My three areas of expertise are event management, corporate talent development strategy, and global business executive consulting. I am certified by Cvent in both Venue Sourcing and Event Management.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,sans-serif;\" class=\"wixui-rich-text__text\">I hold a MBA from Kenan-Flagler Business School at University of North Carolina Chapel Hill where I was the recipient of the Richard H. Jenrette Fellowship for analytic excellence and upon graduation received the teamwork award.&nbsp; I also hold an undergraduate degree in Finance from Texas A&amp;M University.&nbsp;</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,sans-serif;\" class=\"wixui-rich-text__text\">Past and current community service roles include Boys &amp; Girls Clubs of Austin board member (past roles include executive board member, events strategy, and gala chair), the Eanes ISD Campus Leadership Team, Eanes Education Foundation fundraising, and the Lake Austin Chapter of the National Charity League.</span></span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:normal; font-size:14px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:futura-lt-w01-book,sans-serif;\" class=\"wixui-rich-text__text\">I live in Austin, Texas with my husband and three children.&nbsp; I have many personal interests including home renovation, hiking, fine arts, and supporting our three children to become happy, amazing people.&nbsp;</span></span></p></div></div></div></section></div></div></div></div></div></div></div></main><div id=\"soapAfterPagesContainer\" class=\"soapAfterPagesContainer page-without-sosp\"><div data-mesh-id=\"soapAfterPagesContainerinlineContent\" data-testid=\"inline-content\" class=\"\"><div data-mesh-id=\"soapAfterPagesContainerinlineContent-gridContainer\" data-testid=\"mesh-container-content\"><div id=\"comp-jpe7y5rm\" style=\"display:none\"></div><div id=\"comp-k35bvj3k\" class=\"MazNVa comp-k35bvj3k wixui-image rYiAuL\"><a data-testid=\"linkElement\" href=\"https://www.reachmeetings.com/\" target=\"_self\" class=\"j7pOnl\"><img fetchpriority=\"high\" id=\"img_comp-k35bvj3k\" src=\"https://static.wixstatic.com/media/28cd78_b6659293240c40db888d813137f151bc~mv2.jpg/v1/fill/w_240,h_100,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Reach%20Logo%20jpg.jpg\" alt=\"REACH logo\" style=\"object-fit:cover\" class=\"BI8PVQ Tj01hh\" width=\"240\" height=\"100\"></a></div></d